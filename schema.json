components:
  schemas:
    Author:
      type: object
      properties:
        id:
          type: integer
        first_name:
          type: string
        last_name:
          type: string
        email:
          type: string
          format: email
        full_name:
          type: string
          readOnly: true
        profile_photo:
          type: string
          readOnly: true
      required:
      - email
      - first_name
      - full_name
      - id
      - last_name
      - profile_photo
    Bookmark:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        user:
          type: integer
          readOnly: true
        post:
          allOf:
          - $ref: '#/components/schemas/PostList'
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - created_at
      - id
      - post
      - updated_at
      - user
    Category:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        name:
          type: string
          maxLength: 100
        description:
          type: string
          nullable: true
      required:
      - id
      - name
    CheckTokenBeforeObtain:
      type: object
      properties:
        otp_code:
          type: string
        otp_token:
          type: string
        email:
          type: string
          writeOnly: true
        password:
          type: string
          writeOnly: true
      required:
      - email
      - password
    CommentCreate:
      type: object
      properties:
        parent:
          type: integer
          nullable: true
        content:
          type: string
      required:
      - content
    CommentNotificationRead:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        sender:
          allOf:
          - $ref: '#/components/schemas/PublicUser'
          readOnly: true
        receiver:
          allOf:
          - $ref: '#/components/schemas/PublicUser'
          readOnly: true
        post:
          type: string
          readOnly: true
        post_slug:
          type: string
          readOnly: true
        comment:
          type: integer
        comment_id:
          type: integer
          readOnly: true
        message:
          type: string
          maxLength: 255
        is_read:
          type: boolean
        unread_count:
          type: string
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
      required:
      - comment
      - comment_id
      - created_at
      - id
      - message
      - post
      - post_slug
      - receiver
      - sender
      - unread_count
      - updated_at
    CommentReactionResponse:
      type: object
      properties:
        success:
          type: boolean
      required:
      - success
    CommentRead:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        post:
          type: integer
          nullable: true
        author:
          allOf:
          - $ref: '#/components/schemas/Author'
          readOnly: true
        parent:
          type: integer
          nullable: true
        content:
          type: string
        is_edited:
          type: boolean
          readOnly: true
        is_deleted:
          type: boolean
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        updated_at:
          type: string
          format: date-time
          readOnly: true
        reply_count:
          type: string
          readOnly: true
        likes:
          type: integer
          readOnly: true
        dislikes:
          type: integer
          readOnly: true
        user_reaction:
          type: string
          readOnly: true
      required:
      - author
      - content
      - created_at
      - dislikes
      - id
      - is_deleted
      - is_edited
      - likes
      - reply_count
      - updated_at
      - user_reaction
    ConfirmEmailChange:
      type: object
      properties:
        otp_token:
          type: string
        code:
          type: string
          maxLength: 10
      required:
      - code
      - otp_token
    CustomTokenRefresh:
      type: object
      properties:
        refresh:
          type: string
        access:
          type: string
          readOnly: true
      required:
      - access
      - refresh
    DeleteCommentNotification:
      type: object
      properties:
        ids:
          type: array
          items:
            type: integer
          description: List of notification IDs to delete
      required:
      - ids
    DeleteNotificationsResponse:
      type: object
      properties:
        message:
          type: string
        deleted_count:
          type: integer
      required:
      - deleted_count
      - message
    Favourite:
      type: object
      properties:
        id:
          type: integer
          readOnly: true
        user:
          type: integer
          readOnly: true
        post:
          allOf:
          - $ref: '#/components/schemas/PostList'
